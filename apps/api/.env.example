APP_ENV=development
API_PORT=8080
# Local only — never set on Vercel (use `go run ./cmd/migrate` against prod DB instead).
DB_AUTO_MIGRATE=true
DATABASE_URL=postgres://postgres:your_password@localhost:5432/wikiora?sslmode=disable
DB_MAX_OPEN_CONNS=2
DB_MAX_IDLE_CONNS=1
DB_CONN_MAX_LIFETIME=5m
REDIS_URL=redis://localhost:6379/0
# Clerk secret key must match the same Clerk app as VITE_CLERK_PUBLISHABLE_KEY in apps/web/.env
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_clerk_webhook_secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
